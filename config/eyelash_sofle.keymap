#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 3 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <100>;
    delay-ms = <0>;
};

/ {
    // 롤러(인코더) 동작 정의: 마우스 세로 스크롤
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    // 롤러 가로 스크롤: 세로 스크롤과 같은 방향감 (아래로 굴림 = 오른쪽)
    scroll_h_encoder: scroll_h_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_RIGHT>, <&msc SCRL_LEFT>;
        tap-ms = <100>;
    };

    // SYSTEM 레이어 파괴 키 홀드 가드: 1.5초 이상 길게 눌러야 발동, 짧은 탭 = 무동작
    // (레이어 latch 상태에서 오타로 bootloader/reset/off 진입하는 사고 방지 — 2026-07-12)
    boot_hold: boot_hold {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = <1500>;
        bindings = <&bootloader>, <&none>;
    };

    rst_hold: rst_hold {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = <1500>;
        bindings = <&sys_reset>, <&none>;
    };

    off_hold: off_hold {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        tapping-term-ms = <1500>;
        bindings = <&soft_off>, <&none>;
    };

    combos {
        compatible = "zmk,combos";
        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: QWERTY 메인 배열 (중앙 컬럼 ↑↓←→ = 오른쪽 조이스틱)
        layer0 {
            display-name = "QWERTY";
            bindings = <
&kp ESC     &kp N1     &kp N2     &kp N3      &kp N4     &kp N5    &kp UP      &kp N6     &kp N7     &kp N8     &kp N9     &kp N0      &kp BSPC
&kp TAB     &kp Q      &kp W      &kp E       &kp R      &kp T     &kp DOWN    &kp Y      &kp U      &kp I      &kp O      &kp P       &kp BSLH
&kp LCTRL   &kp A      &kp S      &kp D       &kp F      &kp G     &kp LEFT    &kp H      &kp J      &kp K      &kp L      &kp SEMI    &kp SQT
&kp LSHFT   &kp Z      &kp X      &kp C       &kp V      &kp B     &kp RIGHT   &kp N      &kp M      &kp COMMA  &kp DOT    &kp FSLH    &mt RSHFT ENTER
&kp C_MUTE  &kp LCTRL  &kp LGUI   &kp LALT    &mo 1      &kp SPACE &kp ENTER   &kp SPACE  &mo 3      &mo 2      &kp F18    &kp DEL
            >;
            // Layer 0 롤러: 마우스 스크롤 (기본) — 볼륨은 SYSTEM 홀드로 이동
            sensor-bindings = <&scroll_encoder>;
        };

        // Layer 1: Symbol & Mouse (개발용 기호 배치) — D/F = 축소/확대(⌘-/⌘=)
        layer1 {
            display-name = "SYMBOL";
            bindings = <
&kp F12     &kp F1     &kp F2     &kp F3      &kp F4     &kp F5    &mmv MOVE_UP    &kp F6     &kp F7     &kp F8     &kp F9     &kp F10     &trans
&trans      &kp GRAVE  &mkp LCLK  &mkp MCLK   &mkp RCLK  &mkp MB4  &mmv MOVE_DOWN  &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &kp MINUS   &kp EQUAL
&kp CAPS    &kp TILDE  &trans     &kp LG(MINUS) &kp LG(EQUAL) &mkp MB5  &mmv MOVE_LEFT  &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &kp LBKT    &kp RBKT
&trans      &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_SPI &mmv MOVE_RIGHT &rgb_ug RGB_BRI &rgb_ug RGB_BRD &kp INSERT &kp F11 &kp F12 &trans
&kp C_MUTE  &trans     &trans     &trans      &trans     &trans    &mkp LCLK       &trans     &trans     &trans     &trans     &trans
            >;
            // Layer 1 롤러: 해제 (기본과 동일한 세로 스크롤 — 가로는 WIN 홀드로 이동)
            sensor-bindings = <&scroll_encoder>;
        };

        // Layer 2: System & Bluetooth — 파괴 키는 1.5초 홀드 필요(Z·,=reset, C·/=bootloader, .=soft_off), BT_CLR_ALL 제거
        layer2 {
            display-name = "SYSTEM";
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &trans  &trans  &trans  &trans  &trans  &trans
&trans     &bt BT_CLR    &none          &kp LC(LEFT) &kp LC(RIGHT) &trans          &mmv MOVE_DOWN   &trans  &trans  &trans  &trans  &kp UNDER &kp PLUS
&trans     &kp TILDE     &out OUT_BLE  &kp LG(D)     &kp LG(LS(D)) &kp LG(LS(W))   &mmv MOVE_LEFT   &trans  &trans  &trans  &trans  &kp LBRC  &kp RBRC
&kp LG(LA(LEFT)) &rst_hold 0 0 &kp LG(LA(DOWN)) &boot_hold 0 0 &kp LG(LA(UP)) &kp LG(LA(RIGHT)) &mmv MOVE_RIGHT  &trans  &trans  &rst_hold 0 0 &off_hold 0 0 &boot_hold 0 0 &trans
&trans     &trans        &trans        &trans        &trans        &trans          &mkp LCLK        &trans  &trans  &trans  &trans  &trans
            >;
            // Layer 2 롤러: 볼륨 조절 (기본 롤러가 스크롤로 바뀌면서 이동)
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Layer 3: WIN — 윈도우 머신(BT 슬롯2) 단축키. 오른엄지 &mo 3 홀드 → 왼손 자리 배치
        //   (구 오른엄지 ENTER 자리 — 스페이스 착각 조기전송 사고 무해화 겸용)
        //   윗줄 = 가상 데스크톱(W/E/R/T·G), 홈행 = 앱전환·캡처·바탕화면·탐색기, Z=잠금 V=클립보드
        //   오른손 H/L = 이전/다음 탭 (Ctrl+PgUp/PgDn, vim 방향감 — 맥·윈도우 공통)
        layer3 {
            display-name = "WIN";
            bindings = <
&trans  &trans        &trans       &trans            &trans             &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LA(F4)    &kp LG(TAB)  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &kp LC(LG(D))    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp LA(TAB)   &kp LG(LS(S)) &kp LG(D)        &kp LG(E)          &kp LC(LG(F4))   &trans  &kp LC(PG_UP)  &trans  &trans  &kp LC(PG_DN)  &trans  &trans
&trans  &kp LG(L)     &trans       &trans            &kp LG(V)          &trans           &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans       &trans            &trans             &trans           &trans  &trans  &trans  &trans  &trans  &trans
            >;
            // Layer 3 롤러: 가로 스크롤 (오른엄지 홀드+왼손 롤러 = 양손 자세)
            sensor-bindings = <&scroll_h_encoder>;
        };

        // Layer 4: ZMK Studio 확장용 2
        layer4 {
            display-name = "STUDIO2";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        // Layer 5: ZMK Studio 확장용 3
        layer5 {
            display-name = "STUDIO3";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
